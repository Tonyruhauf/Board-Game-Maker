; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Board Game Maker"
config/description="Enter an interesting project description here!"
run/main_scene="uid://mctff602sh74"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

EventBus="*uid://xdyjyg3sm11d"
GameService="*uid://bdl1g4qwu21pe"
StackingManager="*uid://crspyt7axkpwv"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/module_importer/plugin.cfg")

[file_customization]

folder_colors={
"res://BoardGameEngine/": "orange",
"res://BoardGameEngine/Core/": "orange",
"res://BoardGameEngine/Registries/": "red",
"res://BoardGameEngine/Resources/": "yellow",
"res://BoardGameEngine/Shared Assets/": "green",
"res://BoardGameEngine/Systems/": "purple",
"res://BoardGameEngine/UI/": "teal",
"res://script_templates/": "orange"
}

[global_group]

"Player Slots"=""

