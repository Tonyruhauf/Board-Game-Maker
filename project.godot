; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Board Game Maker"
config/description="Enter an interesting project description here!"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

SignalBus="*res://scripts/autoloads/SignalBus.gd"
Toolbox="*res://scripts/autoloads/Toolbox.gd"
SceneTransitioner="*res://modules/SceneTransitioner/autoloads/SceneTransitioner.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/module_importer/plugin.cfg")

[file_customization]

folder_colors={
"res://BoardGameMaker/": "blue",
"res://BoardGameMaker/Core/": "orange",
"res://BoardGameMaker/Networking/": "gray",
"res://BoardGameMaker/Resources/": "yellow",
"res://BoardGameMaker/Shared Assets/": "green",
"res://BoardGameMaker/Systems/": "purple",
"res://BoardGameMaker/UI/": "teal",
"res://script_templates/": "blue"
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
